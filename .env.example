# Healf Health Intelligence Engine - Environment Variables

# --- REQUIRED: LLM & EXTRACTION ---
# Obtain your key at https://platform.openai.com/
OPENAI_API_KEY=sk-...

# --- REQUIRED: WEB SCRAPING ---
# Obtain your key at https://www.firecrawl.dev/
FIRECRAWL_API_KEY=fc-...
# NIH DSLD/RxTerms Key (Optional for low volume)
# Obtain your key at https://dsld.od.nih.gov/api-guide
NIH_DATA_API_KEY=...

# --- REQUIRED: KNOWLEDGE GRAPH (NEO4J) ---
# NEO4J_URI=bolt://localhost:7687  # Local Docker example
# NEO4J_URI=neo4j+s://...          # Neo4j AuraDB example
NEO4J_URI=neo4j+s://...
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=...
NEO4J_DATABASE=neo4j

# --- OPTIONAL: MODEL OVERRIDES ---
# Default is 'gpt-5.4-mini' for all nodes.
# ORCHESTRATOR_MAIN_MODEL=gpt-5.4
# ORCHESTRATOR_LITE_MODEL=gpt-5.4-mini

# Set to 'true' to enable robust LLM-as-a-judge quality gates during orchestration.
# This increases latency and cost but improves grounding verification.
HEALF_USE_DEEPEVAL_GATE=false

# --- OPTIONAL: OBSERVABILITY (ARIZE PHOENIX) ---
# Set to 'true' to enable agent tracing (requires 'arize-phoenix' server running).
HEALF_ENABLE_OBSERVABILITY=false
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
